# Copy to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads this file automatically.

# Postgres password shared by the postgres and web services.
# NOTE (2026-10-07): docker-compose.yml embeds this value in
# SEAMTECH_DATABASE_URL, and REDIS_PASSWORD in SEAMTECH_REDIS_URL. Generate
# URL-safe secrets for these two ("openssl rand -hex 24", or
# "openssl rand -base64 24 | tr '+/' '-_") or percent-encode them ("/" -> "%2F"):
# a raw base64 secret containing "/" breaks the URL (in Redis it becomes the
# database selector). The application refuses to start, with an explicit
# message, when a password in either URL is not encoded.
POSTGRES_PASSWORD=change-me

# Shared secret between the frontend and backend containers. Required
# because docker-compose runs the backend with SEAMTECH_HOST=0.0.0.0 so the
# frontend container can reach it over the Docker network — non-local hosts
# require an auth token (see seamtech_search/config.py). This token is only
# ever used server-to-server; it is never sent to the browser.
SEAMTECH_AUTH_TOKEN=change-me

# UI sign-in for the Next.js frontend (audit issue #5, Lot L.2).
#
# SEAMTECH_AUTH_TOKEN above is a server-to-server secret and is never sent to
# the browser.
#
# Lot L.2 — COMPTES NOMINATIFS. The normal way in is a nominative account
# (utilisateur + session_ui in PostgreSQL, « qui a validé quoi »). Create the
# first one with the CLI, BEFORE anyone signs in:
#
#   python -m seamtech_search.comptes.cli creer \
#       --identifiant imrane --nom "I. N." --role administrateur
#   # mot de passe lu sur STDIN, jamais en argument (visible dans `ps`)
#
# Enumerate and manage them with `… lister`, `… desactiver`,
# `… reinitialiser-mot-de-passe`, `… sessions --identifiant`, `… revoquer-session`.
#
# SEAMTECH_UI_PASSWORD is the RESCUE account (identifiant « secours », role
# administrateur). It exists so a workshop with no account yet is not locked
# out, and to create the first nominative accounts. ASSUMED LIMITATION: it is
# shared, its session has no row in session_ui, so it cannot be revoked and its
# actions are all attributed to « secours ». Leave it EMPTY once the nominative
# accounts exist: the frontend then refuses the rescue path entirely, and only
# nominative accounts can sign in.
#
# The session cookie is signed with SEAMTECH_SESSION_SECRET. Generate with:
#   openssl rand -base64 24     # SEAMTECH_UI_PASSWORD (or pick your own)
#   openssl rand -base64 48     # SEAMTECH_SESSION_SECRET
SEAMTECH_UI_PASSWORD=change-me
SEAMTECH_SESSION_SECRET=change-me

# Session lifetime in hours (default 12). The cookie is httpOnly, SameSite=Lax,
# and marked Secure automatically when SEAMTECH_BEHIND_TLS_PROXY=true.
SEAMTECH_SESSION_HOURS=12

# Assistant sourcé et endpoints ML optionnels : actifs par défaut pour préserver
# le comportement existant. Mettre false pour masquer ces fonctions sur un poste
# à un opérateur (sans supprimer les routes ni désactiver la recherche classique).
SEAMTECH_OPTIONAL_FEATURES_ENABLED=true

# Object Storage (MinIO locally in Docker, Cloudflare R2 or AWS S3 in production)
# --- Administrateur du stockage : PROVISIONNEMENT UNIQUEMENT -----------------
# Ces deux valeurs ne sont JAMAIS données aux services applicatifs (web/worker).
# Elles servent à scripts/provisionner_stockage.sh, qui crée les buckets, les
# identités restreintes et active le versioning. Générer des valeurs aléatoires
# solides sur le serveur d'atelier :
#   openssl rand -hex 24
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Identité APPLICATIVE (web + worker) : obligatoire, dédiée, restreinte ----
# Droits : lecture/écriture des objets du SEUL bucket SEAMTECH_S3_BUCKET.
# Aucun autre bucket, aucune opération d'administration. Créée par :
#   bash scripts/provisionner_stockage.sh
# docker-compose.yml refuse de démarrer si ces variables sont absentes
# (${SEAMTECH_S3_ACCESS_KEY:?...}) : aucun repli sur les identifiants root.
SEAMTECH_S3_ACCESS_KEY=seamtech-app
SEAMTECH_S3_SECRET_KEY=<généré : openssl rand -hex 32>

# --- Identité SAUVEGARDE hors-site : distincte de l'identité applicative ------
# Droits : lecture/écriture du SEUL bucket SEAMTECH_BACKUP_BUCKET. Distincte
# pour qu'une compromission de l'application ne donne pas accès aux sauvegardes.
SEAMTECH_BACKUP_ACCESS_KEY=seamtech-sauvegarde
SEAMTECH_BACKUP_SECRET_KEY=<généré : openssl rand -hex 32>
SEAMTECH_BACKUP_BUCKET=seamtech-backups
SEAMTECH_S3_BUCKET=seamtech-documents

# FACULTATIF — endpoint S3 joignable par les NAVIGATEURS des postes de
# l'atelier (par exemple https://minio.atelier.local). Laissé vide, les
# téléchargements sont servis par l'API authentifiée : c'est le réglage sûr,
# car une URL présignée vers l'endpoint interne (http://minio:9000) n'est
# résolvable que depuis le réseau des conteneurs. Ne le renseigner que si
# l'endpoint est réellement exposé sur le réseau de l'atelier.
SEAMTECH_S3_PUBLIC_ENDPOINT_URL=

# For Cloudflare R2 in production:
# SEAMTECH_STORAGE_BACKEND=s3
# SEAMTECH_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# SEAMTECH_S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# SEAMTECH_S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# SEAMTECH_S3_REGION=auto

# Redis Task Broker & State Store
#
# Persistance : redis démarre avec `--appendonly yes --appendfsync everysec`
# et un volume nommé `redis-data`. Les deux sont nécessaires pour que « import
# accepté » signifie « import exécuté même si le serveur redémarre ».
SEAMTECH_REDIS_URL=redis://redis:6379/0

# Redis password — required by docker-compose (redis, web, worker). `docker compose up`
# fails immediately on a clean checkout without this set.
REDIS_PASSWORD=change-me

# Durabilité des imports (docs/FILE_DURABLE.md).
# SEAMTECH_REQUIRE_DURABLE_QUEUE=true (défaut compose) : si Redis est
# injoignable, l'API REFUSE l'import avec un 503 explicite au lieu de
# l'accepter et de le perdre. Mettre false uniquement en développement, où
# l'import tourne alors dans le processus web (`durability: process_memory`).
SEAMTECH_REQUIRE_DURABLE_QUEUE=true
# Relecture des octets stockés avant purge locale du brouillon (défaut true).
# false = la copie locale est CONSERVÉE, car l'intégrité n'est plus prouvée.
SEAMTECH_STORAGE_VERIFY_REREAD=true

# Verrou optimiste entre postes (défaut true) — NE PAS DÉSACTIVER EN ATELIER.
# true  : toute CORRECTION comme toute DÉCISION (valider/rejeter/rouvrir) doit
#         porter la révision de fiche affichée par le poste. Sans elle, la
#         requête est REFUSÉE (428 « révision absente ») : la protection
#         anti-écrasement ne peut pas disparaître parce qu'une lecture de
#         révision a échoué côté poste. Une révision périmée est refusée (409) :
#         la valeur du collègue est conservée et la décision n'est pas tracée.
# false : réservé à un script ancien IDENTIFIÉ (écriture non protégée, journalisée
#         comme telle). L'écran d'atelier envoie toujours la révision.
SEAMTECH_REQUIRE_REVISION=true

# Le processus web ne doit PAS exécuter d'imports : c'est le rôle du service
# `worker`. Mettre true seulement pour un poste de développement sans worker.
SEAMTECH_WEB_WORKER_ENABLED=false

# Durée (s) avant qu'une tâche dont le worker est mort soit reprise ; minimum 15.
SEAMTECH_TASK_CLAIM_TTL_SECONDS=300
# Nombre de tentatives avant lettre morte (raison enregistrée en base), 1 à 20.
SEAMTECH_MAX_TASK_ATTEMPTS=3

# Host folder the app is allowed to scan (mount it into the web service too
# in docker-compose.yml if you change it).
SEAMTECH_ROOT_PATHS=/data/SEAMTECH/DesignFiles

# Optional host-side PostgreSQL integration test connection.
SEAMTECH_TEST_DATABASE_URL=postgresql://seamtech:change-me@127.0.0.1:5433/seamtech_search
