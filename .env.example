# Copy to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads this file automatically.

# Postgres password shared by the postgres and web services.
POSTGRES_PASSWORD=change-me

# Shared secret between the frontend and backend containers. Required
# because docker-compose runs the backend with SEAMTECH_HOST=0.0.0.0 so the
# frontend container can reach it over the Docker network — non-local hosts
# require an auth token (see seamtech_search/config.py). This token is only
# ever used server-to-server; it is never sent to the browser.
SEAMTECH_AUTH_TOKEN=change-me

# Optional host-side PostgreSQL integration test connection.
# Set this after starting the postgres service to run tests/test_postgres_integration.py.
SEAMTECH_TEST_DATABASE_URL=postgresql://seamtech:change-me@127.0.0.1:5433/seamtech_search
