# Copy to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads this file automatically.

# Postgres password shared by the postgres and web services.
POSTGRES_PASSWORD=change-me

# Shared secret between the frontend and backend containers. Required
# because docker-compose runs the backend with SEAMTECH_HOST=0.0.0.0 so the
# frontend container can reach it over the Docker network — non-local hosts
# require an auth token (see seamtech_search/config.py). This token is only
# ever used server-to-server; it is never sent to the browser.
SEAMTECH_AUTH_TOKEN=change-me

# UI sign-in for the Next.js frontend (audit issue #5, Option B).
#
# SEAMTECH_AUTH_TOKEN above is a server-to-server secret and is never sent to
# the browser. SEAMTECH_UI_PASSWORD is the password the operator actually types
# at /login; one shared password is enough because a single person uses this
# app. Without it the login endpoint fails closed (HTTP 503) — nobody gets in,
# rather than everybody getting in.
#
# Generate both with:
#   openssl rand -base64 24     # SEAMTECH_UI_PASSWORD (or pick your own)
#   openssl rand -base64 48     # SEAMTECH_SESSION_SECRET
SEAMTECH_UI_PASSWORD=change-me
SEAMTECH_SESSION_SECRET=change-me

# Session lifetime in hours (default 12). The cookie is httpOnly, SameSite=Lax,
# and marked Secure automatically when SEAMTECH_BEHIND_TLS_PROXY=true.
SEAMTECH_SESSION_HOURS=12

# Object Storage (MinIO locally in Docker, Cloudflare R2 or AWS S3 in production)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
SEAMTECH_S3_BUCKET=seamtech-documents

# For Cloudflare R2 in production:
# SEAMTECH_STORAGE_BACKEND=s3
# SEAMTECH_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# SEAMTECH_S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# SEAMTECH_S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# SEAMTECH_S3_REGION=auto

# Redis Task Broker & State Store
SEAMTECH_REDIS_URL=redis://redis:6379/0

# Redis password — required by docker-compose (redis, web). `docker compose up`
# fails immediately on a clean checkout without this set.
REDIS_PASSWORD=change-me

# Host folder the app is allowed to scan (mount it into the web service too
# in docker-compose.yml if you change it).
SEAMTECH_ROOT_PATHS=/data/SEAMTECH/DesignFiles

# Optional host-side PostgreSQL integration test connection.
SEAMTECH_TEST_DATABASE_URL=postgresql://seamtech:change-me@127.0.0.1:5433/seamtech_search
