{
  "root_paths": [
    "/data/SEAMTECH/DesignFiles"
  ],
  "database_path": "data/search.db",
  "database_url": null,
  "host": "127.0.0.1",
  "port": 8000,
  "excluded_names": [
    ".git",
    "__pycache__",
    "node_modules",
    "Thumbs.db"
  ],
  "excluded_extensions": [
    ".tmp",
    ".bak"
  ],
  "max_extract_chars": 200000,
  "max_file_size_bytes": 536870912,
  "extraction_timeout_seconds": 60,
  "enable_legacy_office": false,
  "libreoffice_command": "soffice",
  "enable_ocr": false,
  "tesseract_command": "tesseract",
  "ocrmypdf_command": "ocrmypdf",
  "external_extraction_timeout_seconds": 120,
  "external_extractors": {},
  "allow_network_access": false,
  "auth_token": null,
  "behind_tls_proxy": false,
  "rate_limit_per_minute": 600,
  "reports_retention_days": 90,
  "staged_retention_days": 7,
  "audit_retention_days": 365,
  "min_free_bytes": 1073741824,
  "storage_backend": "s3",
  "s3_endpoint_url": null,
  "s3_bucket": "seamtech-documents",
  "s3_access_key": null,
  "s3_secret_key": null,
  "s3_region": "us-east-1",
  "s3_force_path_style": true,
  "s3_prefix": "",
  "delete_local_after_upload": false,
  "redis_url": null,
  "pool_min": 1,
  "pool_max": 10,
  "pool_timeout": 30.0,
  "statement_timeout_ms": 5000
}
